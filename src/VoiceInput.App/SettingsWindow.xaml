<Window
    x:Class="VoiceInput.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Codex Voice Input · 设置">
    <Grid x:Name="Root" RequestedTheme="Light">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="WindowTint" Color="#A6F5F5F7" />
                        <SolidColorBrush x:Key="SidebarFill" Color="#58FFFFFF" />
                        <SolidColorBrush x:Key="CardFill" Color="#D9FFFFFF" />
                        <SolidColorBrush x:Key="Hairline" Color="#12000000" />
                        <SolidColorBrush x:Key="Ink" Color="#FF1D1D1F" />
                        <SolidColorBrush x:Key="SecondaryInk" Color="#FF6E6E73" />
                        <SolidColorBrush x:Key="PrimaryFill" Color="#FF1D1D1F" />
                        <SolidColorBrush x:Key="PrimaryInk" Color="White" />
                        <SolidColorBrush x:Key="PrimaryHover" Color="#FF38383A" /><SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FF1D1D1F" /><SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FF38383A" /><SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FF515154" /><SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="White" /><SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="White" /><SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="White" />
                        <SolidColorBrush x:Key="SoftFill" Color="#0C000000" />
                        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF1D1D1F" />
                        <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF38383A" />
                        <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF515154" />
                        <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF1D1D1F" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#10000000" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#18000000" />

            </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="WindowTint" Color="#AD1C1C1E" />
                        <SolidColorBrush x:Key="SidebarFill" Color="#302C2C2E" />
                        <SolidColorBrush x:Key="CardFill" Color="#D52C2C2E" />
                        <SolidColorBrush x:Key="Hairline" Color="#1EFFFFFF" />
                        <SolidColorBrush x:Key="Ink" Color="#FFF5F5F7" />
                        <SolidColorBrush x:Key="SecondaryInk" Color="#FFAEAEB2" />
                        <SolidColorBrush x:Key="PrimaryFill" Color="#FFF5F5F7" />
                        <SolidColorBrush x:Key="PrimaryInk" Color="#FF1D1D1F" />
                        <SolidColorBrush x:Key="PrimaryHover" Color="#FFDADADD" /><SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FFF5F5F7" /><SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FFDADADD" /><SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FFBDBDC2" /><SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FF1D1D1F" /><SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FF1D1D1F" /><SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FF1D1D1F" />
                        <SolidColorBrush x:Key="SoftFill" Color="#10FFFFFF" />
                        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFF5F5F7" />
                        <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FFDADADD" />
                        <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FFBDBDC2" />
                        <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFF5F5F7" />
                        <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FF1D1D1F" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#18FFFFFF" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#22FFFFFF" />

            </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
                <Style x:Key="Card" TargetType="Border">
                    <Setter Property="Background" Value="{ThemeResource CardFill}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource Hairline}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="18" />
                    <Setter Property="Padding" Value="18" />
                </Style>
                <Style x:Key="SectionLabel" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{ThemeResource SecondaryInk}" />
                    <Setter Property="Margin" Value="4,8,0,0" />
                </Style>
                <Style TargetType="Button">
                    <Setter Property="CornerRadius" Value="11" />
                    <Setter Property="Padding" Value="16,9" />
                    <Setter Property="Background" Value="{ThemeResource SoftFill}" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Foreground" Value="{ThemeResource Ink}" />
                </Style>
                <Style TargetType="TextBox">
                    <Setter Property="CornerRadius" Value="10" />
                    <Setter Property="Padding" Value="12,10" />
                </Style>
                <Style TargetType="PasswordBox">
                    <Setter Property="CornerRadius" Value="10" />
                    <Setter Property="Padding" Value="12,10" />
                </Style>
                <Style TargetType="ComboBox">
                    <Setter Property="CornerRadius" Value="10" />
                    <Setter Property="Padding" Value="12,9" />
                </Style>

                <Style x:Key="PrimaryButton" TargetType="Button">
                    <Setter Property="CornerRadius" Value="18" />
                    <Setter Property="Padding" Value="18,9" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background" Value="{ThemeResource PrimaryFill}" />
                    <Setter Property="Foreground" Value="{ThemeResource PrimaryInk}" />
                </Style>            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="184" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.RowSpan="3" Grid.ColumnSpan="2" Background="{ThemeResource WindowTint}" />
        <Border Grid.RowSpan="3" Background="{ThemeResource SidebarFill}" BorderBrush="{ThemeResource Hairline}" BorderThickness="0,0,1,0" />
        <Grid x:Name="TitleBarDragRegion" Grid.ColumnSpan="2" Padding="24,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/codex-voice-input.png" Width="20" Height="20" />
                <TextBlock Text="Codex Voice Input" FontSize="12" FontWeight="SemiBold"
                           Foreground="{ThemeResource SecondaryInk}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Padding="14,22,14,0" Spacing="26">
            <StackPanel Margin="12,0,0,0" Spacing="4">
                <TextBlock Text="设置" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource Ink}" />
            </StackPanel>
            <ListView x:Name="Navigation" SelectionMode="Single" IsItemClickEnabled="True"
                      SelectionChanged="Navigation_SelectionChanged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="CornerRadius" Value="11" />
                        <Setter Property="Margin" Value="0,3" />
                        <Setter Property="Padding" Value="12,12" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Grid Background="Transparent" CornerRadius="11">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal" />
                                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="SelectionFill.Opacity" Value="0.5" /></VisualState.Setters></VisualState>
                                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="SelectionFill.Opacity" Value="0.7" /></VisualState.Setters></VisualState>
                                                <VisualState x:Name="Selected"><VisualState.Setters><Setter Target="SelectionFill.Opacity" Value="1" /></VisualState.Setters></VisualState>
                                                <VisualState x:Name="SelectedPointerOver"><VisualState.Setters><Setter Target="SelectionFill.Opacity" Value="1" /></VisualState.Setters></VisualState>
                                                <VisualState x:Name="SelectedPressed"><VisualState.Setters><Setter Target="SelectionFill.Opacity" Value="1" /></VisualState.Setters></VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <Border x:Name="SelectionFill" CornerRadius="11" Background="{ThemeResource SoftFill}" Opacity="0" />
                                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}"
                                                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListViewItem Tag="robot">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE95A;" FontSize="17" Foreground="{ThemeResource Ink}" />
                        <TextBlock Text="机器人" Foreground="{ThemeResource Ink}" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="history">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE81C;" FontSize="17" Foreground="{ThemeResource Ink}" />
                        <TextBlock Text="识别记录" Foreground="{ThemeResource Ink}" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="general">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE713;" FontSize="17" Foreground="{ThemeResource Ink}" />
                        <TextBlock Text="设置" Foreground="{ThemeResource Ink}" />
                    </StackPanel>
                </ListViewItem>
            </ListView>
        </StackPanel>


        <Button Grid.Row="2" Margin="20,0,20,16" Padding="12,10" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left" Background="Transparent" Click="Exit_Click"
                ToolTipService.ToolTip="退出程序并断开机器人连接">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE7E8;" FontSize="15" />
                <TextBlock Text="退出程序" FontSize="13" />
            </StackPanel>
        </Button>
        <Grid Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Margin="28,18,28,20">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ScrollViewer x:Name="RobotPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="20" Padding="0,0,4,16">
                    <TextBlock Text="机器人" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource Ink}" />
                    <Border Style="{StaticResource Card}" Padding="20">
                        <StackPanel Spacing="18">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="13" Background="{ThemeResource SoftFill}">
                                    <FontIcon Glyph="&#xE95A;" FontSize="21" Foreground="{ThemeResource Ink}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                    <TextBlock Text="语音机器人" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource Ink}" />
                                    <Grid ColumnSpacing="7">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Ellipse x:Name="ConnectionDot" Width="6" Height="6" Fill="{ThemeResource SecondaryInk}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ConnectionText" Grid.Column="1" Text="正在检查连接…"
                                                   FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryInk}" />
                                    </Grid>
                                </StackPanel>
                                <Button x:Name="AddRobotButton" Grid.Column="2" Content="添加机器人" Click="AddRobot_Click"
                                        FontSize="12" Padding="12,8" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="RobotRuntimeText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource SecondaryInk}" />
                            <StackPanel x:Name="PairingEditor" Visibility="Collapsed" Spacing="12">
                                <Border Height="1" Background="{ThemeResource Hairline}" />
                                <TextBlock Text="请在机器人上开启配对模式，显示六位配对码后搜索。" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource SecondaryInk}" />
                                <ComboBox x:Name="PairingRobotsBox" PlaceholderText="选择机器人" HorizontalAlignment="Stretch" />
                                <TextBox x:Name="PairingCodeBox" MaxLength="6" PlaceholderText="六位配对码" InputScope="Number" FontSize="18" CharacterSpacing="100" AutomationProperties.Name="机器人配对码" />
                                <TextBlock x:Name="PairingStatus" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryInk}" />
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <Button x:Name="CancelPairingButton" Content="取消" Click="CancelPairing_Click" />
                                    <Button x:Name="PairingSearchButton" Content="重新搜索" Click="SearchRobots_Click" />
                                    <Button x:Name="PairRobotButton" Content="配对" Click="PairRobot_Click" Style="{StaticResource PrimaryButton}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel Spacing="10">
                        <TextBlock Text="语音输入" FontSize="15" FontWeight="SemiBold" Margin="4,0,0,0" Foreground="{ThemeResource Ink}" />
                        <Border Style="{StaticResource Card}" Padding="20,18">
                            <StackPanel Spacing="16">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="开始听写" FontSize="13" Foreground="{ThemeResource SecondaryInk}" />
                                    <TextBlock Grid.Column="1" Text="“开启语音输入”" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource Ink}" TextWrapping="Wrap" />
                                </Grid>
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="确认发送" FontSize="13" Foreground="{ThemeResource SecondaryInk}" />
                                    <TextBlock Grid.Column="1" Text="“发送”" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource Ink}" />
                                </Grid>
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="恢复聊天" FontSize="13" Foreground="{ThemeResource SecondaryInk}" />
                                    <TextBlock Grid.Column="1" Text="“退出模式”" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource Ink}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="GeneralPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="20" Padding="0,0,4,16">
                    <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource Ink}" />
                    <StackPanel Spacing="10">
                        <TextBlock Text="外观" Style="{StaticResource SectionLabel}" />
                        <Border Style="{StaticResource Card}" Padding="18,16">
                            <Grid>
                                <TextBlock Text="深色模式" VerticalAlignment="Center" FontSize="14" Foreground="{ThemeResource Ink}" />
                                <ToggleSwitch x:Name="DarkModeToggle" HorizontalAlignment="Right" MinWidth="0" OffContent="" OnContent=""
                                    Toggled="DarkMode_Toggled" AutomationProperties.Name="深色模式" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Grid x:Name="HistoryPage" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="0,0,0,20">
                    <TextBlock Text="识别记录" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource Ink}" />
                    <Button Content="清空记录" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ClearHistory_Click" />
                </Grid>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6" Margin="0,0,4,16">
                    <Grid>
                        <ListView x:Name="HistoryList" SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="CornerRadius" Value="12" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="10,12" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="7">
                                            <TextBlock Text="{Binding DisplayTime}" FontSize="11" Foreground="{ThemeResource SecondaryInk}" />
                                            <TextBlock Text="{Binding Text}" FontSize="13" MaxLines="5" TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis" Foreground="{ThemeResource Ink}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Width="34" Height="34" Padding="0" Tag="{Binding Text}" Click="CopyHistory_Click"
                                                ToolTipService.ToolTip="复制" AutomationProperties.Name="复制这条记录">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="EmptyHistoryText" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                            <FontIcon Glyph="&#xE81C;" FontSize="30" Foreground="{ThemeResource SecondaryInk}" />
                            <TextBlock Text="还没有识别记录" Foreground="{ThemeResource SecondaryInk}" FontSize="13" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <TextBlock x:Name="StatusText" Grid.Row="1" FontSize="12" Margin="4,8,4,0" Visibility="Collapsed"
                       Foreground="{ThemeResource SecondaryInk}" TextWrapping="Wrap" MaxLines="3" />        </Grid>

    </Grid>
</Window>
